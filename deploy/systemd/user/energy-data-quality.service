[Unit]
Description=Earthship energy analytics data-quality check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sat/Solar_PV/analytics
Environment=PYTHONPATH=/home/sat/Solar_PV/analytics/src
EnvironmentFile=-%h/.config/hex/openhab.env
ExecStart=/usr/bin/flock --nonblock %t/energy-data-quality.lock /usr/bin/python3 -m earthship_energy.scheduled data-quality
SuccessExitStatus=10 20
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/earthship-energy
