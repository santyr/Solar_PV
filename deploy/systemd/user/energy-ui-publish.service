[Unit]
Description=Publish observational Earthship analytics to OpenHAB
After=network-online.target energy-daily-aggregate.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sat/Solar_PV/analytics
Environment=PYTHONPATH=/home/sat/Solar_PV/analytics/src
EnvironmentFile=-%h/.config/hex/openhab.env
ExecStart=/usr/bin/flock --nonblock %t/energy-ui-publish.lock /usr/bin/python3 -m earthship_energy.scheduled energy-ui-publish
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
