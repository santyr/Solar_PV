[Unit]
Description=Verify Earthship PostgreSQL restore-point evidence

[Service]
Type=oneshot
WorkingDirectory=/home/sat/Solar_PV/analytics
Environment=PYTHONPATH=/home/sat/Solar_PV/analytics/src
EnvironmentFile=-%h/.config/hex/openhab.env
ExecStart=/usr/bin/flock --nonblock %t/energy-backup-check.lock /usr/bin/python3 -m earthship_energy.scheduled backup-check --manifest /home/sat/backups/earthship-energy/2026-08-20/backup-manifest.json
SuccessExitStatus=10 20
TimeoutStartSec=600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/earthship-energy
