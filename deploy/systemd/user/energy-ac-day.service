[Unit]
Description=Append qualified previous-day inverter AC observation
After=network-online.target energy-daily-aggregate.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sat/Solar_PV/analytics
Environment=PYTHONPATH=/home/sat/Solar_PV/analytics/src
ExecStart=/usr/bin/flock --nonblock %t/energy-ac-day.lock /usr/bin/python3 -m earthship_energy.scheduled ac-day --jdbc-config /home/sat/.config/hex/energy-power-writer.jdbc --power-evidence-policy /home/sat/Solar_PV/analytics/config/power-evidence.json --ac-evidence-policy /home/sat/Solar_PV/analytics/config/ac-evidence.json
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
